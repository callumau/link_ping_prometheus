# Hardened systemd unit for link_ping_prometheus.
#
# Install:
#   cp installer/linux/link_ping_prometheus.service /etc/systemd/system/
#   # CLI flags go in OPTIONS inside /etc/link_ping_prometheus.env, e.g.:
#   #   OPTIONS="-mode=both -listen=:4000 -allow=203.0.113.5 -metrics=:2112"
#   # Secrets (LINK_PING_METRICS_USER/LINK_PING_METRICS_PASS,
#   # LINK_PING_ECHO_SECRET) go in the same file, never in service args.
#   #   LINK_PING_ECHO_SECRET=...
#   chmod 600 /etc/link_ping_prometheus.env
#   systemctl daemon-reload && systemctl enable --now link_ping_prometheus
#
#   # Hot reload of the targets file (client/both with -targets):
#   #   systemctl reload link_ping_prometheus
#   # Fallback for a unit that predates the ExecReload= line below (or a
#   # systemd too old for it):
#   #   systemctl kill -s HUP link_ping_prometheus
#   # SIGHUP only reloads when the unit runs with -targets: without it the
#   # binary installs no handler, so the signal terminates the process
#   # (Restart=on-failure restarts it — an unintended bounce, not a reload).
#   # Windows services have no SIGHUP — use -targets-reload-interval there.
#
# time-sync.target ordering is load-bearing: with -echo-secret set, the
# server's replay guard uses a 30s timestamp window, so clocks must be
# roughly NTP-synchronized.
#
# Restart=on-failure + RestartSec=5s mirrors the Windows service
# hardening (SCM OnFailure=restart, 5s delay) in main.go serviceConfig().

[Unit]
Description=Link Ping Prometheus (UDP link monitor)
Documentation=https://github.com/callumau/link_ping_prometheus
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=simple
EnvironmentFile=-/etc/link_ping_prometheus.env
ExecStart=/usr/local/bin/link_ping_prometheus $OPTIONS
# SIGHUP re-reads the -targets file without a restart (client/both modes).
# Only run `systemctl reload` on a unit started with -targets: main.go
# registers the handler only then, so otherwise the signal would kill the
# process (Restart=on-failure brings it back, but that is a bounce).
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
KillSignal=SIGTERM
# Adjust user/group per distro if needed (nogroup is Debian/Ubuntu).
User=nobody
Group=nogroup
StateDirectory=link-ping
LogsDirectory=link-ping

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# AF_NETLINK is for IPv6 zone-name resolution only: an -allow/-target address
# with a %zone (%eth0, %eth0.100) is resolved through net.InterfaceByName,
# which is an RTM_GETLINK netlink query. Without it every zone-qualified target
# fails to dial and reads as down. That lookup needs no new privilege (it is
# reads, not CAP_NET_ADMIN), so the family is safe to allow.
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK
# The agent needs no capabilities at all: the DF bit and DSCP are unprivileged
# socket options, and the echo port (4000) is unprivileged, so an empty
# bounding set costs nothing.
CapabilityBoundingSet=
PrivateDevices=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
# 0077: anything the agent creates (its log file) starts private to its user,
# and the binary's own 0600 enforcement then repairs nothing because there is
# nothing to repair.
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

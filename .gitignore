build/*
*.log
link_ping_prometheus
link_ping_prometheus.exe
.pi/
dist/

# live per-host target list; the format is documented in docs/targets-file.md
targets.json

# local-only dev deploy helper (site data lives outside the repo, in
# ~/.config/lpp/dev.env; credentials come from 1Password at run time)
dev_push.sh

.venv-ansible/

# key material and credential files the binary consumes (-metrics-tls-key,
# -metrics-tls-cert, LINK_PING_* credential env files). Never commit them.
.env
.env.*
*.key
*.pem
*.p12
*.pfx
credentials*

# Windows VERSIONINFO resources generated by
# installer/windows/gen-versioninfo.sh (see docs/release-signing.md)
resource_windows_*.syso

  "editable": true,
  "description": "Site-to-site link monitor (UDP echo probes). Latency panels (Current RTT, Percentiles, Average, Jitter) are RTT in ms, derived from link_rtt_seconds (seconds) via histogram_quantile/rate; they gap during outages. Packet Loss = 100 * rate(link_probes_timed_out_total)/rate(link_probes_sent_total) — true network loss (UDP never retransmits), reading ~100% during a full outage; a shorter rate window catches shorter outages. The server-side link_server_probes_received_total is a cross-check on the client's sent counter.",
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          },
          "unit": "ms",
          "decimals": 2
        },
        "overrides": []
      },
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto"
      },
      "pluginVersion": "12.1.0-246536",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, rate(link_rtt_seconds_bucket{job=~\"$job\", target=~\"$target\"}[5m])) * 1000",
          "instant": true,
          "legendFormat": "{{target}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Current RTT",
      "type": "stat",
      "description": "Median (p50) round-trip time over the last 5 minutes, in ms. No RTT samples during an outage -> gap; check Link Status."
    },
